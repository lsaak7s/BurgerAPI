/* 
=============================================================================
CONFIGURAÇÃO DO SEQUELIZE CLI (.sequelizerc)
=============================================================================
Padrão da arquitetura / Configuração de Ferramentas CLI:
- Orienta o Sequelize CLI (ou bibliotecas de migração como Umzug) sobre a
  estrutura de diretórios do projeto.
- 'config': Aponta para as credenciais de banco em "src/config/database.cjs".
- 'migrations-path': Indica onde estão os scripts de migração em "src/database/migrations".
- 'models-path': Indica o diretório dos modelos em "src/app/models".
=============================================================================
*/

const { resolve } = require('node:path');

module.exports = {
	config: resolve(__dirname, 'src', 'config', 'database.cjs'),
	'migrations-path': resolve(__dirname, 'src', 'database', 'migrations'),
	'models-path': resolve(__dirname, 'src', 'app', 'models'),
};